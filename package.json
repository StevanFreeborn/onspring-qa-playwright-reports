{
  "name": "onspring-qa-playwright-reports",
  "private": true,
  "version": "1.0.0",
  "description": "This is an application designed to store and present playwright html reports generated from Onspring QA tests.",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "start:render": "prisma migrate deploy && prisma generate && node server.js",
    "test:server": "cross-env NODE_ENV=test node tests/e2e/server.js",
    "dev": "cross-env TZ=utc nodemon -q server.js",
    "test": "cross-env NODE_ENV=test jest && npx playwright test",
    "test:unit": "cross-env NODE_ENV=test jest --selectProjects unit-node unit-browser --no-cache",
    "test:integration": "cross-env NODE_ENV=test jest --selectProjects integration --no-cache",
    "test:e2e": "cross-env NODE_ENV=test playwright test",
    "lint:check": "eslint .",
    "lint:fix": "eslint --fix .",
    "format:check": "prettier --check .",
    "format:fix": "prettier --log-level silent --write .",
    "migrate": "prisma migrate dev",
    "generate": "prisma generate",
    "studio": "prisma studio",
    "build": "npm add -D prisma && npm install && prisma migrate deploy && prisma generate",
    "build:render": "npm add -D prisma && npm install",
    "prepare": "husky"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "author": {
    "name": "Stevan Freeborn",
    "email": "stevan.freeborn@gmail.com",
    "url": "https://stevanfreeborn.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/StevanFreeborn/onspring-qa-playwright-reports.git"
  },
  "license": "MIT",
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.63.0",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.5.1",
    "babel-jest": "^30.4.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.16.6",
    "eslint-plugin-jsdoc": "^64.4.0",
    "eslint-plugin-playwright": "^2.12.0",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jest": "^30.5.1",
    "jest-environment-jsdom": "^30.5.1",
    "jsdom": "^30.0.1",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6",
    "prisma": "^7.10.0",
    "supertest": "^7.2.2"
  },
  "dependencies": {
    "@datalust/winston-seq": "^3.0.1",
    "@logtail/node": "^0.5.8",
    "@logtail/winston": "^0.5.8",
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/client": "7.10.0",
    "@quixo3/prisma-session-store": "^3.1.21",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^13.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "express-validator": "^7.3.2",
    "morgan": "^1.12.1",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "winston": "^3.19.0"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0",
    "mysql2": "^3.12.0"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true,
    "cpu-features@0.0.10": true,
    "ssh2@1.17.0": true,
    "unrs-resolver@1.12.2": true,
    "@prisma/engines@7.10.0": true,
    "prisma@7.10.0": true,
    "@parcel/watcher@2.6.0": true,
    "protobufjs@7.6.6": true
  }
}
